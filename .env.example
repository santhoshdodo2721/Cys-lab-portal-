# Copy to .env. This file contains examples, never real credentials.
# Local development database:
MONGODB_URI=mongodb://mongodb:27017/lab-portal
# Shared database: replace the value above with your hosted connection string.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/lab-portal
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Lab Admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Server-only Google Cloud Translation API key (enable Cloud Translation API).
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_DAILY_CHARACTER_LIMIT=250000

# Easier alternative: Gemini key from Google AI Studio. Takes priority when set.
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
